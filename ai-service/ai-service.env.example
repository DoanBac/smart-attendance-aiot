# AI Face Inference Service — Environment Variables
# cp ai-service.env.example ai-service.env

# Model configuration
MODEL_STORAGE_PATH=/app/models
MODEL_NAME=buffalo_sc
DET_SIZE=640
COSINE_THRESHOLD=0.65
MIN_BLUR_VAR=60.0
MIN_FACE_RATIO=0.05

# Internal service auth key — phải khớp với AI_SERVICE_SECRET_KEY trong backend/.env
SERVICE_SECRET_KEY=ai-service-internal-secret-change-in-prod
