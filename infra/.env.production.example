# Smart Attendance — Production Environment Variables
# Copy to backend/.env, ai-service/.env, frontend/.env.local and fill in values.
# NEVER commit files with real secrets.

# ── Backend (/opt/smart-attendance/backend/.env) ──────────────────────────────
APP_NAME=Smart Attendance AIoT
APP_VERSION=1.0.0
DEBUG=false

# RDS endpoint (injected by EC2 user-data)
DATABASE_URL=postgresql+asyncpg://attendance_user:CHANGE_ME@rds-host.ap-southeast-1.rds.amazonaws.com:5432/attendance_db

# ElastiCache endpoint (injected by EC2 user-data)
REDIS_URL=redis://elasticache-host.cache.amazonaws.com:6379/0

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["https://your-domain.com"]

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=100

# AI microservice URL (internal Docker network)
AI_SERVICE_URL=http://ai-service:8001

# ── AI Service (/opt/smart-attendance/ai-service/.env) ───────────────────────
# REDIS_URL is same as above
MIN_FACE_CONFIDENCE=0.6
MIN_BLUR_ENROLLMENT=20.0

# ── Frontend (/opt/smart-attendance/frontend/.env.local) ─────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws
