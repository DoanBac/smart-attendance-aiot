# Edge Device Configuration
# Copy this file to config/device.env and fill in the values

# ── Device Identity ────────────────────────────────────────────────────────────
# Token from Admin Dashboard > Devices > (your device token)
DEVICE_TOKEN=your_device_token_here

# Class ID this device belongs to
CLASS_ID=1

# ── Cloud API ─────────────────────────────────────────────────────────────────
# URL of the Cloud backend (no trailing slash)
CLOUD_API_URL=http://192.168.1.100

# How often to sync offline queue (seconds). Actual interval uses exponential backoff.
SYNC_INTERVAL_SEC=30

# ── Camera ────────────────────────────────────────────────────────────────────
# "0" for first USB webcam, "1" for second, or RTSP URL e.g. rtsp://192.168.1.50/stream
CAMERA_SOURCE=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAPTURE_FPS=10
PROCESS_EVERY_N_FRAMES=3

# ── AI Models (ONNX, mounted via docker-compose volumes) ──────────────────────
DETECTION_MODEL=/app/models/yolov8_face_320.onnx
EMBEDDING_MODEL=/app/models/arcface_r100.onnx
DEPTH_MODEL=/app/models/depth_lite.onnx

# ── Face Recognition ──────────────────────────────────────────────────────────
# Cosine similarity threshold (0.0–1.0). Lower = more permissive, Higher = stricter.
COSINE_THRESHOLD=0.50

# Eye-blink EAR threshold for liveness (typical 0.20–0.30)
LIVENESS_BLINK_THRESHOLD=0.25

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256 key as hex string (64 hex chars = 32 bytes)
# Must match the AES_KEY on the Cloud backend exactly.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AES_KEY=your_64_char_hex_key_here

# ── Local Storage ─────────────────────────────────────────────────────────────
LOCAL_DB_PATH=/app/data/local.db
LOG_PATH=/app/data/edge.log
LOG_LEVEL=INFO

# ── ONNX Runtime ──────────────────────────────────────────────────────────────
# Number of CPU threads for inference (match to physical core count)
ORT_NUM_THREADS=4
